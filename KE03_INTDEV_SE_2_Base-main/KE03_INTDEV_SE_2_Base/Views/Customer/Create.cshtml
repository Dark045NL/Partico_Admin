@model DataAccessLayer.Models.Customer

@{
    ViewData["Title"] = "Nieuwe Klant";
}

<h1 class="mb-4">Nieuwe Klant</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Naam</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Address" class="form-label">Adres</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" asp-for="Active" id="activeCheck" />
        <label class="form-check-label" for="activeCheck">Actief</label>
    </div>

    <div>
        <button type="submit" class="btn btn-success me-2">💾 Aanmaken</button>
        <a asp-action="Index" class="btn btn-secondary">⬅️ Terug naar overzicht</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
