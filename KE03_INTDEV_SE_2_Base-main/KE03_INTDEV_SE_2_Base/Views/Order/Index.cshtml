@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Bestellingen";
}

<h1 class="mb-4">🧾 Bestellingen</h1>

<a class="btn btn-primary mb-3" asp-action="Create">➕ Nieuwe bestelling</a>

<table class="table table-striped table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Datum</th>
            <th>Klant</th>
            <th>Producten</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderDate.ToShortDateString()</td>
                <td>@order.Customer?.Name</td>
                <td>
                    @if (order.OrderProducts.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var op in order.OrderProducts)
                            {
                                <li>@op.Product.Name (@op.Quantity st.)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Geen producten</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@order.Id">✏️ Bewerken</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@order.Id">🔍 Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@order.Id">🗑️ Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>
