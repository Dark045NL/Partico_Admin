@model DataAccessLayer.Models.Order

@{
    ViewData["Title"] = "Bestelgegevens";
}

<h1>🧾 Bestelling Details</h1>

<dl class="row">
    <dt class="col-sm-2">Datum</dt>
    <dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd>

    <dt class="col-sm-2">Klant</dt>
    <dd class="col-sm-10">@Model.Customer?.Name</dd>

    <dt class="col-sm-2">Producten</dt>
    <dd class="col-sm-10">
        @if (Model.OrderProducts.Any())
        {
            <ul>
                @foreach (var item in Model.OrderProducts)
                {
                    <li>@item.Product.Name - @item.Quantity stuks</li>
                }
            </ul>
        }
        else
        {
            <span class="text-muted">Geen producten gekoppeld</span>
        }
    </dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Bewerken</a>
<a asp-action="Index" class="btn btn-secondary">⬅️ Terug</a>
