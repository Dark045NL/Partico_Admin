@model DataAccessLayer.Models.Order
@{
    ViewData["Title"] = "Bewerk bestelling";
    var selectedProducts = Model.OrderProducts?.ToDictionary(p => p.ProductId, p => p.Quantity) ?? new();
}

<h1>✏️ Bewerk Bestelling</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="OrderDate" class="form-label">Datum</label>
            <input asp-for="OrderDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerId" class="form-label">Klant</label>
            <select asp-for="CustomerId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Customers, "Id", "Name"))">
                <option value="">-- Selecteer klant --</option>
            </select>
        </div>
    </div>

    <hr />
    <h5>Producten toevoegen</h5>
    <div class="row">
        @for (int i = 0; i < ((List<DataAccessLayer.Models.Product>)ViewBag.Products).Count; i++)
        {
            var product = ((List<DataAccessLayer.Models.Product>)ViewBag.Products)[i];
            <div class="col-md-6 mb-2">
                <div class="form-check">
                    <input type="checkbox" name="selectedProductIds" value="@product.Id"
                           @(selectedProducts.ContainsKey(product.Id) ? "checked" : "") class="form-check-input" id="product_@product.Id" />
                    <label class="form-check-label fw-bold" for="product_@product.Id">@product.Name</label>
                </div>
                <input type="number" name="quantities" class="form-control form-control-sm mt-1"
                       value="@(selectedProducts.ContainsKey(product.Id) ? selectedProducts[product.Id] : 1)"
                       min="1" />
            </div>
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">💾 Opslaan</button>
        <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
