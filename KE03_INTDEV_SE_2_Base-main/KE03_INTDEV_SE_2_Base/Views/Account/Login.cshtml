
@model LoginViewModel

@{
    ViewData["Title"] = "Inloggen";
    Layout = "_LoginLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h3 class="card-title text-center mb-4">🔐 Beheer Login</h3>

        <form id="loginForm" asp-action="Login" method="post" onsubmit="return validateLoginForm();">
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Gebruikersnaam</label>
                <input asp-for="Username" class="form-control" id="username" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Wachtwoord</label>
                <input asp-for="Password" type="password" class="form-control" id="password" />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-dark">Inloggen</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        function validateLoginForm() {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();

            if (!username || !password) {
                alert("Om in te loggen moet je beide velden invullen.");
                return false;
            }

            return true;
        }
    </script>
}