@model IEnumerable<DataAccessLayer.Models.Product>

@{
    ViewData["Title"] = "Producten";
}

<h1>Producten</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">➕ Nieuw product</a>
</p>

<table class="table table-striped table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Naam</th>
            <th>Beschrijving</th>
            <th>Prijs</th>
            <th>Onderdelen</th>
            <th>Actief</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>€@item.Price.ToString("N2")</td>
                <td>
                    @if (item.Parts != null && item.Parts.Any())
                    {
                        <ul class="mb-0 ps-3">
                            @foreach (var part in item.Parts)
                            {
                                <li>@part.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Geen onderdelen</span>
                    }
                </td>
                <td>@(item.Active ? "✅" : "❌")</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">✏️ Bewerken</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.Id">🔍 Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">🗑️ Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>
