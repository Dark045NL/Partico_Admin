@model DataAccessLayer.Models.Product

@{
    ViewData["Title"] = "Productdetails";
}

<h1 class="mb-4">📦 Productdetails</h1>

<div class="card mb-4">
    <div class="card-header fw-bold">
        Productinformatie
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Naam</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Beschrijving</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Prijs</dt>
            <dd class="col-sm-9">€ @Model.Price.ToString("N2")</dd>

            <dt class="col-sm-3">Actief</dt>
            <dd class="col-sm-9">@(Model.Active ? "✅ Ja" : "❌ Nee")</dd>
        </dl>
    </div>
</div>

@if (Model.Parts != null && Model.Parts.Any())
{
    <div class="card mb-4">
        <div class="card-header fw-bold">
            Gekoppelde Onderdelen
        </div>
        <div class="card-body">
            <ul class="list-group">
                @foreach (var part in Model.Parts)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@part.Name</strong><br />
                            <small class="text-muted">@part.Description</small>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Er zijn geen onderdelen gekoppeld aan dit product.</div>
}

<div>
    <a class="btn btn-primary me-2" asp-action="Edit" asp-route-id="@Model.Id">✏️ Bewerken</a>
    <a class="btn btn-secondary" asp-action="Index">⬅️ Terug naar overzicht</a>
</div>
