@model DataAccessLayer.Models.Part

@{
    ViewData["Title"] = "Nieuw onderdeel";
}

<h1 class="mb-4">Nieuw Onderdeel</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Naam</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Description" class="form-label">Beschrijving</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-success me-2">💾 Opslaan</button>
        <a asp-action="Index" class="btn btn-secondary">⬅️ Terug naar overzicht</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
