@model DataAccessLayer.Models.Part

@{
    ViewData["Title"] = "Nieuw onderdeel";
}

<h1 class="mb-4">Onderdeel bewerken</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Naam</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Description" class="form-label">Beschrijving</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Active" id="activeCheck" />
        <label class="form-check-label" for="activeCheck">Actief</label>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success me-2">💾 Opslaan</button>
        <a asp-action="Index" class="btn btn-secondary">⬅️ Terug</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
